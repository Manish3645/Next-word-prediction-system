# Runtime artifacts required by the Demo V3 Streamlit application.
!/models/demo_v3/tokenizer.pkl
!/models/demo_v3/experiments/*/best_model.keras

# Demo V2 remains usable in the app when its legacy runtime artifacts are included.
!/models/demo_v2/tokenizer.pkl
!/models/demo_v2/rnn/rnn_model.keras
!/models/demo_v2/lstm/lstm_model.keras
